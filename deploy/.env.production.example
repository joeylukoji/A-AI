# Copier vers deploy/.env sur l'instance (jamais committer deploy/.env).
# Génération automatique : AAI_DOMAIN=app.exemple.com ACME_EMAIL=ops@exemple.com ./deploy/gen-env.sh
#
# En APP_ENV=production l'API refuse de démarrer si SESSION_SECRET, INTERNAL_TOKEN,
# S3_ACCESS_KEY ou S3_SECRET_KEY valent encore les placeholders de développement.

# --- Domaine / TLS (obligatoire : cookies Secure + CSRF) ---
AAI_DOMAIN=app.exemple.com
ACME_EMAIL=ops@exemple.com
PUBLIC_BASE_URL=https://app.exemple.com
APP_ENV=production
TRUST_PROXY_HEADERS=1

# --- Postgres (réseau Docker uniquement, pas de port public) ---
POSTGRES_USER=aai
POSTGRES_DB=aai
POSTGRES_PASSWORD=dev-secret-change-me-in-production
DATABASE_URL=postgres://aai:dev-secret-change-me-in-production@postgres:5432/aai?sslmode=disable

# --- Redis ---
REDIS_PASSWORD=dev-secret-change-me-in-production
REDIS_URL=redis://:dev-secret-change-me-in-production@redis:6379/0

# --- Secrets applicatifs (l'API refuse ces placeholders si APP_ENV=production) ---
SESSION_SECRET=dev-secret-change-me-in-production
INTERNAL_TOKEN=dev-internal-token

# --- MinIO (stockage objet local à l'instance) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aai-artifacts
S3_USE_PATH_STYLE=1
S3_REGION=us-east-1

# --- IA / workers ---
AI_BASE_URL=http://ai:8000
QCAD_URL=
# 1 = démo sans clés payantes (plans heuristiques). 0 + TOGETHER_API_KEY = NLU/images réels.
AI_STUB=1
TOGETHER_API_KEY=
TOGETHER_NLU=1
TOGETHER_PLANNER=1
TOGETHER_PLANNER_MODEL=openai/gpt-oss-120b
TOGETHER_PLANNER_EFFORT=low
IMAGE_BACKEND=together
IMAGE_RENDERER=gemini
TOGETHER_IMAGE_STYLE=illustration
TOGETHER_IMAGE_LABELS=none
TOGETHER_IMAGE_MAX_PX=1280
TOGETHER_IMAGE_TIMEOUT=240
EDENAI_API_KEY=
# Editeur 2D et 3D en pause : seul l'apercu image est montre, sans repli vectoriel
# si l'API image echoue ("Apercu indisponible"). 0 pour tout reactiver.
GEMINI_ONLY=1
EDENAI_IMAGE_MODEL=image/generation/google/gemini-3-pro-image-preview

# --- Admin plateforme : créer le compte PUIS coller l'email et redémarrer l'API ---
ADMIN_EMAILS=

# --- Stripe : laisser vide pour la preview (billing stub / plan free) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUREAU=
