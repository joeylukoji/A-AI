# --- Dev/local defaults only ---
# En APP_ENV=production, l'API refuse de démarrer si SESSION_SECRET,
# INTERNAL_TOKEN, S3_ACCESS_KEY ou S3_SECRET_KEY valent encore ces
# placeholders (voir internal/config.Config.Validate). Générer des valeurs
# aléatoires, p.ex. : openssl rand -hex 32
DATABASE_URL=postgres://aai:aai@postgres:5432/aai?sslmode=disable
REDIS_URL=redis://redis:6379/0
SESSION_SECRET=dev-secret-change-me-in-production
INTERNAL_TOKEN=dev-internal-token
# Mettre à 1 uniquement si l'API tourne derrière un reverse proxy/LB de
# confiance qui pose lui-même X-Forwarded-For (sinon un client peut usurper
# son IP et contourner le rate limiting).
TRUST_PROXY_HEADERS=0
AI_BASE_URL=http://ai:8000
AI_STUB=1
# Refine GAN (pix2pix). AI_STUB=1 => filtre PIL. Pour le vrai modele :
# AI_STUB=0
# GAN_WEIGHTS=research/benchmarks/results/gan_refine/last.pt
GAN_WEIGHTS=
# HouseDiffusion (model250000.pt). AI_STUB=0 + fichier présent → plan vectoriel.
# HOUSEDIFFUSION_WEIGHTS=C:\Users\Joy\Desktop\A-AI\model250000.pt
# HOUSEDIFFUSION_STEPS=80
HOUSEDIFFUSION_WEIGHTS=
HOUSEDIFFUSION_STEPS=80
# ControlNet Canny (https://huggingface.co/lllyasviel/sd-controlnet-canny).
# AI_STUB=0 CONTROLNET=1 — netteté d'image seulement, pas le PlanDocument.
CONTROLNET=
# --- Image : Gemini 3 Pro via Eden AI (Together sert au NLU / pavage, pas au dessin) ---
# EDENAI_API_KEY est obligatoire pour l'apercu API. Sans elle : rendu vectoriel local.
# TOGETHER_API_KEY reste utilise pour le NLU / pavage (gpt-oss-120b).
EDENAI_API_KEY=
EDENAI_IMAGE_MODEL=image/generation/google/gemini-3-pro-image-preview
TOGETHER_API_KEY=
IMAGE_BACKEND=together
# Rendu de l'apercu : illustration (defaut, couleurs + mobilier) | cad (noir/blanc) | render3d
TOGETHER_IMAGE_STYLE=illustration
# Noms de pieces : none (defaut, overlay local exact) | model (Gemini ecrit, deconseille)
TOGETHER_IMAGE_LABELS=none
# Rendu de l'apercu : gemini (defaut) | vector (dessin local)
IMAGE_RENDERER=gemini
TOGETHER_IMAGE_MAX_PX=1280
# Timeout de l'appel image Gemini (secondes)
TOGETHER_IMAGE_TIMEOUT=240
# LLM Together (openai/gpt-oss-120b) : NLU + pavage des pieces. 0 pour desactiver.
TOGETHER_PLANNER=1
TOGETHER_NLU=1
TOGETHER_PLANNER_MODEL=openai/gpt-oss-120b
# effort de raisonnement gpt-oss : low (defaut, ~10-20 s) | medium | high
TOGETHER_PLANNER_EFFORT=low
# TOGETHER_IMAGE_STEPS=32
# TOGETHER_IMAGE_MAX_PX=1024
# blender-worker uses AI_STUB=0 in docker-compose (real Blender 4.2.5)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aai-artifacts
S3_USE_PATH_STYLE=1
PUBLIC_BASE_URL=http://localhost:8080
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUREAU=
APP_ENV=development
# Administrateurs plateforme : emails séparés par des virgules. Ces comptes
# voient /admin (tous les plans de toutes les organisations). La liste est
# réappliquée à chaque démarrage : retirer un email révoque son accès.
# IMPORTANT : créer le compte AVANT d'ajouter son email ici. Une adresse listée
# ne peut plus être utilisée pour s'inscrire (sinon n'importe qui pourrait la
# revendiquer et obtenir l'accès à toutes les organisations).
ADMIN_EMAILS=
# QCAD Community (GPLv3) optionnel : normalise le DXF après export.
# Windows local : C:\Program Files\QCAD\qcadcmd.exe
QCAD_BIN=
# Docker plus tard (profil compose "qcad") :
#   docker compose -f deploy/docker-compose.yml --profile qcad up --build
# L'API Compose pointe déjà sur http://qcad:9090 (no-op tant que le service est arrêté).
QCAD_URL=
