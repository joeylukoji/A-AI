{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a-ai.local/schemas/building-spec.schema.json",
  "title": "BuildingSpec",
  "type": "object",
  "required": ["version", "brief", "rooms"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "brief": { "type": "string", "minLength": 1 },
    "total_area_m2": { "type": "number", "exclusiveMinimum": 0 },
    "floors": { "type": "integer", "minimum": 1, "maximum": 5, "default": 1 },
    "style": {
      "type": "string",
      "enum": ["contemporary", "traditional", "minimal", "mediterranean", "other"]
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "living",
              "kitchen",
              "bedroom",
              "bathroom",
              "garage",
              "hallway",
              "dining",
              "office",
              "storage",
              "wc",
              "laundry",
              "other"
            ]
          },
          "area_m2": { "type": "number", "exclusiveMinimum": 0 },
          "count": { "type": "integer", "minimum": 1, "default": 1 },
          "adjacent_to": {
            "type": "array",
            "items": { "type": "string" }
          },
          "open_to": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orthogonal": { "type": "boolean", "default": true },
        "max_width_m": { "type": "number", "exclusiveMinimum": 0 },
        "max_depth_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
